<Project Sdk="Microsoft.NET.Sdk">
  <!-- Mirrors Unity 6 script compilation constraints for the Core assembly:
       C# 9, netstandard2.1, no implicit usings. A build failure here means
       Unity's compiler would reject the Core sources even though the net8.0
       ParityRunner accepts them. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Scripts/Core/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
